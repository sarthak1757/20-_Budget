# Copy this file to .env and fill in the values.

# MongoDB connection string (local, Docker or Atlas)
MONGO_URI=mongodb://localhost:27017/budget-draft

# Port the API + Socket.io server listens on
PORT=4000

# Password for the /admin page (at least 8 characters)
ADMIN_PASSWORD=change-me-please

# Where the React app runs; used for CORS and share links
CLIENT_URL=http://localhost:5173

# (client) Where the React app finds the server. Read by Vite.
VITE_SERVER_URL=http://localhost:4000
