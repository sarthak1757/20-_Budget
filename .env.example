# Copy this file to .env and fill in the values.

# MongoDB connection string (local, Docker or Atlas)
MONGO_URI=mongodb://localhost:27017/budget-draft

# Port the API + Socket.io server listens on
PORT=4000

# Password for the /admin page (at least 8 characters)
ADMIN_PASSWORD=change-me-please

# Where the React app runs; the only other origin allowed by CORS.
# Required in production (the app's own URL, e.g. https://budget-draft.onrender.com)
CLIENT_URL=http://localhost:5173

# development | production. In production the server also serves client/dist.
# NODE_ENV=production

# (client, development only) Where the React app finds the server. Read by Vite.
# A production build always talks to the server it was loaded from.
VITE_SERVER_URL=http://localhost:4000
